# Five9 API Credentials (admin account required)
FIVE9_USERNAME=your_admin_username
FIVE9_PASSWORD=your_admin_password

# Data center: "ca" (Canada), "us", or "eu"
FIVE9_DATA_CENTER=ca

# Report names — change only if your Five9 account uses custom names
FIVE9_REPORT_FOLDER=Call Log Reports
FIVE9_REPORT_NAME=Call Log

# Dashboard auto-refresh interval in seconds (default: 300 = 5 minutes)
REFRESH_INTERVAL=300
